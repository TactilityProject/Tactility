/dts-v1/;

#include <tactility/bindings/root.h>
#include <tactility/bindings/esp32_ble.h>
#include <tactility/bindings/esp32_wifi_pinned.h>
#include <tactility/bindings/esp32_gpio.h>
#include <tactility/bindings/esp32_i2c_master.h>
#include <bindings/tca95xx.h>
#include <bindings/bma530.h>
#include <bindings/bq27427.h>
#include <bindings/iqs323.h>
#include <bindings/trmnl_x_power.h>

/ {
	compatible = "root";
	model = "TRMNL X";

	wifi0 {
		compatible = "espressif,esp32-wifi-pinned";
	};

	ble0 {
		compatible = "espressif,esp32-ble";
	};

	gpio0 {
		compatible = "espressif,esp32-gpio";
		gpio-count = <49>;
	};

	i2c_internal {
		compatible = "espressif,esp32-i2c-master";
		port = <I2C_NUM_0>;
		clock-frequency = <400000>;
		pin-sda = <&gpio0 39 GPIO_FLAG_NONE>;
		pin-scl = <&gpio0 40 GPIO_FLAG_NONE>;

		tca9535: tca9535 {
			compatible = "ti,tca9535";
			reg = <0x20>;
		};

		bma530: bma530 {
			compatible = "bosch,bma530";
			reg = <0x18>;
		};

		bq27427: bq27427 {
			compatible = "ti,bq27427";
			reg = <0x55>;
		};

		iqs323: iqs323 {
			compatible = "azoteq,iqs323";
			reg = <0x44>;
			pin-ready = <&gpio0 3 GPIO_FLAG_NONE>;
			power-mode = <1>;
			sensor-setup = [
				0x0401 0x0C7F 0x1390 0x04CF 0x030A 0x0000 0x1774 0x0064 0x6444 0x53D9
				0x0101 0x0C7F 0x1390 0x01CF 0x030A 0x0000 0x12C4 0x0064 0x5E47 0x53D6
				0x0201 0x0C7F 0x1390 0x02CF 0x030A 0x0000 0x1774 0x0064 0x5C44 0x4BA2
			];
			channel-setup = [
				0x0000 0x4414 0x001B 0x00C8
				0x0000 0x4414 0x001A 0x00C8
				0x0000 0x4414 0x001A 0x00C8
			];
			slider-setup = [ 0x000B 0x1400 0x00C8 0x0800 0x0007 0x0552 0x0430 0x0472 0x04B4 ];
			gesture-setup = [ 0x000F 0x0032 0x015E 0x01F4 0x0258 0x0190 0x01F4 ];
			filter-setup = [ 0x0102 0x0C0C 0x0000 0x0102 0x0014 ];
			timing-setup = [ 0x0010 0x003C 0x0064 0x0BB8 0x07D0 ];
			general-setup = [ 0x0000 0x00C8 0x7575 0x1802 0x0A08 ];
		};
	};

	power {
		compatible = "trmnl,trmnl-x-power";
		pin-power-good = <&tca9535 0 GPIO_FLAG_ACTIVE_LOW>;
		pin-charge-status = <&tca9535 2 GPIO_FLAG_ACTIVE_LOW>;
		pin-otg = <&tca9535 1 GPIO_FLAG_NONE>;
		pin-battery-detect = <&tca9535 7 GPIO_FLAG_NONE>;
		pin-gauge-reset = <&tca9535 10 GPIO_FLAG_ACTIVE_LOW>;
		gauge = <&bq27427>;
	};
};
