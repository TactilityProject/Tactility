msgid "Add by key"
msgstr "Toevoegen met sleutel"

msgid "Add channel"
msgstr "Kanaal toevoegen"

msgid "Add contact"
msgstr "Contact toevoegen"

msgid "Add seen"
msgstr "Gezien toevoegen"

msgid "Cancelled"
msgstr "Geannuleerd"

msgid "Channel key"
msgstr "Kanaalsleutel"

msgid "Channels"
msgstr "Kanalen"

msgid "Contacts"
msgstr "Contacten"

msgid "Couldn't add contact"
msgstr "Contact toevoegen mislukt"

msgid "Couldn't create QR code"
msgstr "QR-code maken mislukt"

msgid "Couldn't create channel"
msgstr "Kanaal maken mislukt"

