msgstr "Netwerk: {}"

msgid "Region: {}"
msgstr "Regio: {}"

msgid "Radio: {} MHz, {} kHz, SF{}, CR 4/{}, {} dBm"
msgstr "Radio: {} MHz, {} kHz, SF{}, CR 4/{}, {} dBm"

msgid "Duty cycle: unrestricted"
msgstr "Duty cycle: onbeperkt"

msgid "Duty cycle: {} s of {} s used ({}% allowed)"
msgstr "Duty cycle: {} s van {} s gebruikt ({}% toegestaan)"

msgid "Transmitting is paused until the budget frees up"
msgstr "Zenden is gepauzeerd tot het budget weer vrij is"

msgid "Waiting to transmit: {}"
msgstr "Wachten om te zenden: {}"

msgid "Frames: {} sent, {} failed, {} received, {} unreadable"
msgstr "Frames: {} verzonden, {} mislukt, {} ontvangen, {} onleesbaar"

msgid "Messages: {} received, {} sent, {} failed"
msgstr "Berichten: {} ontvangen, {} verzonden, {} mislukt"

msgid "Nodes heard: {}, contacts: {}"
msgstr "Nodes gehoord: {}, contacten: {}"

msgid "Set path"
msgstr "Pad instellen"

msgid "Reset path"
msgstr "Pad resetten"

msgid "No contacts"
msgstr "Geen contacten"

msgid "Add a contact first."
msgstr "Voeg eerst een contact toe."

msgid "Couldn't change path"
msgstr "Pad kon niet worden gewijzigd"

msgid "Repeater hashes in hexadecimal, e.g. a1,b2,c3"
msgstr "Hashes van de repeaters in hexadecimaal, bijv. a1,b2,c3"

msgid "Invalid path"
msgstr "Ongeldig pad"

msgid "Enter the hashes of the repeaters as hexadecimal characters, all of the same length, separated by commas."
msgstr "Voer de hashes van de repeaters in als hexadecimale tekens, allemaal even lang en gescheiden door komma's."

msgid "The path is too long."
msgstr "Het pad is te lang."

msgid "Delete message history"
msgstr "Berichtengeschiedenis verwijderen"

msgid "All messages of this conversation are deleted."
msgstr "Alle berichten van dit gesprek worden verwijderd."

msgid "Delete"
msgstr "Verwijderen"

msgid "Couldn't delete"
msgstr "Verwijderen mislukt"

msgid "Turn mesh on to delete the messages."
msgstr "Zet Mesh aan om de berichten te verwijderen."

