"Content-Type: text/plain; charset=UTF-8\n"
"Language: es-ES\n"

msgid " via "
msgstr " por "

msgid "Add by key"
msgstr "Añadir por clave"

msgid "Add channel"
msgstr "Añadir canal"

msgid "Add contact"
msgstr "Añadir contacto"

msgid "Add seen"
msgstr "Añadir visto"

msgid "Cancelled"
msgstr "Cancelado"

msgid "Channel key"
msgstr "Clave del canal"

msgid "Channels"
msgstr "Canales"

msgid "Contacts"
msgstr "Contactos"

msgid "Couldn't add contact"
msgstr "No se pudo añadir el contacto"

msgid "Couldn't create QR code"
msgstr "No se pudo crear el código QR"

msgid "Couldn't create channel"
msgstr "No se pudo crear el canal"

msgid "Couldn't join channel"
msgstr "No se pudo unir al canal"

msgid "Couldn't remove"
msgstr "No se pudo eliminar"

msgid "Create private channel"
msgstr "Crear canal privado"

msgid "Delivered"
msgstr "Entregado"

msgid "Enter a name for the channel."
msgstr "Introduce un nombre para el canal."

msgid "Enter the key as hexadecimal characters, two for every byte."
msgstr "Introduce la clave en caracteres hexadecimales, dos por byte."

msgid "Enter the public key as hexadecimal characters, two for every byte."
msgstr "Introduce la clave pública en caracteres hexadecimales, dos por byte."

msgid "Hashtag channel name, e.g. #test. To join Public, delete the # first."
msgstr "Nombre de canal con hashtag, p. ej. #test. Para unirte a Public, borra primero el #."

msgid "Invalid key"
msgstr "Clave no válida"

msgid "Join channel"
msgstr "Unirse a un canal"

msgid "Join private channel"
msgstr "Unirse a un canal privado"

msgid "Join public channel"
msgstr "Unirse a un canal público"

msgid "Key of the channel in hexadecimal"
msgstr "Clave del canal en hexadecimal"

msgid "Leave channel"
msgstr "Salir del canal"

msgid "Mesh Contacts"
msgstr "Contactos mesh"

msgid "Mesh is "
msgstr "Mesh está "

msgid "Mesh: {}"
msgstr "Mesh: {}"

msgid "Name of the channel"
msgstr "Nombre del canal"

msgid "Name of the contact"
msgstr "Nombre del contacto"

msgid "No contacts yet. Add a node that you've heard, or wait for a direct message."
msgstr "Aún no hay contactos. Añade un nodo que hayas oído o espera un mensaje directo."

msgid "No nodes heard yet. Nodes that you hear on the mesh are listed here."
msgstr "Aún no se han oído nodos. Los nodos que oigas en la malla aparecen aquí."

msgid "Not available"
msgstr "No disponible"

msgid "Not delivered"
msgstr "No entregado"

msgid "OFF"
msgstr "APAGADO"

msgid "Public key"
msgstr "Clave pública"

msgid "Public key of the contact in hexadecimal"
msgstr "Clave pública del contacto en hexadecimal"

msgid "Remove"
msgstr "Quitar"

msgid "Remove contact"
msgstr "Eliminar contacto"

msgid "Send"
msgstr "Enviar"

msgid "Sending..."
msgstr "Enviando..."

msgid "Sent"
msgstr "Enviado"

msgid "Show my QR"
msgstr "Mostrar mi QR"

msgid "The key isn't available."
msgstr "La clave no está disponible."

msgid "The messages are kept, but new messages in this channel aren't received anymore."
msgstr "Los mensajes se conservan, pero ya no se reciben mensajes nuevos de este canal."

msgid "The messages are kept."
msgstr "Los mensajes se conservan."

msgid "There are too many contacts."
msgstr "Hay demasiados contactos."

msgid "This channel can't be left."
msgstr "No se puede salir de este canal."

msgid "This mesh network can't share a contact as a QR code."
msgstr "Esta red mesh no puede compartir un contacto como código QR."

msgid "This mesh network expects a key of a different length."
msgstr "Esta red mesh espera una clave de otra longitud."

msgid "This mesh network expects a public key of a different length."
msgstr "Esta red mesh espera una clave pública de otra longitud."

msgid "Turn mesh on to send messages"
msgstr "Activa mesh para enviar mensajes"

msgid "Type a message..."
msgstr "Escribe un mensaje..."

msgid "Use a channel name that starts with # or Public. This mesh network can't join a channel by name."
msgstr "Usa un nombre de canal que empiece por # o Public. Esta red mesh no puede unirse a un canal por nombre."

msgid "Using "
msgstr "Usando "

msgid "Waiting"
msgstr "Esperando"

msgid "You"
msgstr "Tú"
