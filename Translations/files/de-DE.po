msgid "\"{}\" already exists."
msgstr "„{}“ existiert bereits."

msgid "\"{}\" can't be pasted into itself."
msgstr "„{}“ kann nicht in sich selbst eingefügt werden."

msgid "\"{}\" changed while the dialog was open."
msgstr "„{}“ wurde geändert, während der Dialog geöffnet war."

msgid "\"{}\" could not be copied."
msgstr "„{}“ konnte nicht kopiert werden."

msgid "\"{}\" could not be moved."
msgstr "„{}“ konnte nicht verschoben werden."

msgid "\"{}\" is not an executable."
msgstr "„{}“ ist keine ausführbare Datei."

msgid "\"{}\" was copied but the original could not be removed."
msgstr "„{}“ wurde kopiert, aber das Original konnte nicht entfernt werden."

# TN: "Bist du sicher?" may read as to "Are you secure?", reflexive pronoun added to disambiguate
msgid "Are you sure?"
# msgstr "Bist du sicher?"
msgstr "Bist du dir sicher?"

msgid "Could not eject \"{}\"."
msgstr "„{}“ konnte nicht ausgeworfen werden."

msgid "Could not remove \"{}\" before overwriting."
msgstr "„{}“ konnte vor dem Überschreiben nicht entfernt werden."

msgid "Could not run \"{}\"."
msgstr "„{}“ konnte nicht ausgeführt werden."

# TN: Maybe broken in prev. translation, Kagi Translate argrees on that if {} is a comma separated list, else the prev. one was fine if in brackets
msgid "Do you want to delete these {} items?"
# msgstr "Möchtest du diese {} Elemente löschen?"
msgstr "Möchtest du die Elemente {} löschen?"


msgid "Do you want to delete this?\n{}"
msgstr "Möchtest du dies löschen?\n{}"

msgid "Do you want to install {}?"
msgstr "Möchtest du {} installieren?"

msgid "Eject failed"
msgstr "Auswerfen fehlgeschlagen"

# TN: Needed  accusative, "Name" is a weak masculine noun (n-declension)
msgid "Enter filename:"
# msgstr "Dateiname eingeben:"
msgstr "Dateinamen eingeben:"

msgid "Enter folder name:"
msgstr "Ordnernamen eingeben:"

msgid "File exists"
msgstr "Datei existiert"

msgid "Files"
msgstr "Dateien"

# TN: Capitalization fix
msgid "Install?"
# msgstr "Diese Datei Installieren?"
msgstr "Diese Datei installieren?"


msgid "New File"
msgstr "Neue Datei"

msgid "New Folder"
msgstr "Neuer Ordner"

msgid "Overwrite"
msgstr "Überschreiben"

msgid "Overwrite \"{}\"?"
msgstr "„{}“ überschreiben?"

msgid "Paste failed"
msgstr "Einfügen fehlgeschlagen"

msgid "Rename"
msgstr "Umbenennen"

msgid "Rename failed"
msgstr "Umbenennen fehlgeschlagen"

msgid "Run failed"
msgstr "Ausführen fehlgeschlagen"
